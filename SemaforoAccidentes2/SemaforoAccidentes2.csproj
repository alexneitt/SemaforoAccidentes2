
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>traffic-light-icon-vector2-removebg-preview.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="traffic-light-icon-vector2-removebg-preview.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
  </ItemGroup>

    <ItemGroup>
    <Compile Update="FormMain.cs" />
    <Compile Update="FormMain.Designer.cs">
      <DependentUpon>FormMain.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="FormMain.resx">
      <DependentUpon>FormMain.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="FormRegistro.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FormRegistro.Designer.cs">
      <DependentUpon>FormRegistro.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="FormRegistro.resx">
      <DependentUpon>FormRegistro.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>